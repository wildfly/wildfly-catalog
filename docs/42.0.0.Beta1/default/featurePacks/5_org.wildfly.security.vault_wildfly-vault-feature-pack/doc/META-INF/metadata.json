      "value" : "HashiCorp Vault"
    }, {
      "name" : "org.wildfly.description",
      "value" : "Support for HashiCorp Vault"
    }, {
      "name" : "org.wildfly.rule.add-on-description",
      "value" : "Support for HashiCorp Vault in the management model"
    } ],
    "configurations" : [ ],
    "packages" : [ "org.wildfly.extension.hashicorp-vault" ]
  } ]
}