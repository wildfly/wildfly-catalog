{
  "groupId" : "org.wildfly.security.vault",
  "artifactId" : "wildfly-vault-feature-pack",
  "version" : "1.0.0.Final",
  "name" : "WildFly Vault Feature Pack",
  "description" : "WildFly feature pack for credential stores backed by external vaults",
  "licenses" : [ "Apache License, Version 2.0" ],
  "url" : "http://www.jboss.org",
  "scm-url" : "https://github.com/wildfly-security-incubator/wildfly-vault-feature-pack",
  "copyright" : null,
  "layers" : [ {
    "name" : "hashicorp-vault",
    "stability" : "community",
    "dependencies" : [ {
